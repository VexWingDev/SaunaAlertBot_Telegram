# Telegram section
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Leave empty initially. Only needed if the DAS API returns 401/403.
# Copy the complete Cookie request-header value from your logged-in DAS browser session.
DAS_COOKIE=your_cookie_here
# Example: DAS_COOKIE=token=your_token_here; authenticated=true



# Optional - feel free to alter it if you wish the bot to scan it every few seconds - minutes - hours.
POLL_SECONDS=120 # Scans every 120 seconds, or 2 minutes by default. Change it for shorter or longer time.
INITIAL_NOTIFY=true # Leave this as true to receive an initial notification when the bot starts.

# If the API uses a different value for free slots, change this.
AVAILABLE_STATUSES=available,free,open
