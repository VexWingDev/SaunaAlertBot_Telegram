# Telegram section
# Раздел Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Leave empty initially. Only needed if the DAS API returns 401/403.
# Сначала оставьте пустым. Требуется только если API DAS возвращает 401/403.
# Copy the complete Cookie request-header value from your logged-in DAS browser session.
# Скопируйте полное значение заголовка Cookie из сеанса браузера с выполненным входом в DAS.
DAS_COOKIE=your_cookie_here
# Example: DAS_COOKIE=token=your_token_here; authenticated=true
# Пример: DAS_COOKIE=token=your_token_here; authenticated=true



# Optional - feel free to alter it if you wish the bot to scan it every few seconds - minutes - hours.
# Необязательно - измените значение, если хотите, чтобы бот проверял слоты каждые несколько секунд, минут или часов.
POLL_SECONDS=120 # Scans every 120 seconds, or 2 minutes by default. Change it for shorter or longer time. / По умолчанию проверяет каждые 120 секунд, то есть 2 минуты. Измените значение для более короткого или длительного интервала.
INITIAL_NOTIFY=true # Leave this as true to receive an initial notification when the bot starts. / Оставьте значение true, чтобы получить первоначальное уведомление при запуске бота.

# If the API uses a different value for free slots, change this.
# Если API использует другое значение для свободных слотов, измените это значение.
AVAILABLE_STATUSES=available,free,open
